# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Required: OpenAI API key (used by generate_script.py and generate_images.py)
OPENAI_API_KEY=sk-...

# Voice profile (all optional — defaults shown)
VOICE_PROVIDER=gtts        # gtts | openai
VOICE_LOCALE=en-US         # BCP-47 language tag (e.g. en-GB, fr-FR)
VOICE_SPEED=1.0            # 0.5 – 2.0  (gTTS ignores this)
VOICE_PITCH=default        # default | low | high
VOICE_ID=                  # OpenAI TTS voice: alloy | echo | fable | onyx | nova | shimmer
