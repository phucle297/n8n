# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── AI Provider ───────────────────────────────────────────────────────────────
# Controls which AI is used for script generation (generate_script.py)
# and image generation (generate_images.py).
#
#   openai  → uses OPENAI_API_KEY  | text: GPT-4o  | images: DALL-E 3
#   gemini  → uses GEMINI_API_KEY  | text: Gemini 1.5 Pro | images: Imagen 3
#
AI_PROVIDER=openai

# Set the key that matches your chosen AI_PROVIDER:
OPENAI_API_KEY=sk-...        # required when AI_PROVIDER=openai
GEMINI_API_KEY=              # required when AI_PROVIDER=gemini

# ── Voice Profile ─────────────────────────────────────────────────────────────
# Controls narration audio synthesis (generate_voice.py). Independent of AI_PROVIDER.
#
VOICE_PROVIDER=gtts          # gtts (free, no key) | openai (requires OPENAI_API_KEY)
VOICE_LOCALE=en-US           # BCP-47 language tag (e.g. en-GB, fr-FR)
VOICE_SPEED=1.0              # 0.5 – 2.0  (gTTS ignores this)
VOICE_PITCH=default          # default | low | high
VOICE_ID=                    # OpenAI TTS voice: alloy | echo | fable | onyx | nova | shimmer
